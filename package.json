{
  "name": "revogrid-demos",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=18",
    "pnpm": ">=10"
  },
  "scripts": {
    "setup": "node scripts/orchestrate.mjs setup",
    "dev": "node scripts/serve-gallery.mjs",
    "build": "node scripts/orchestrate.mjs build",
    "build:gallery": "node scripts/build-gallery.mjs",
    "test": "node scripts/orchestrate.mjs test",
    "test:e2e": "node scripts/orchestrate.mjs test:e2e",
    "preview": "node scripts/serve-gallery.mjs",
    "media:inspect": "node scripts/run-feature.mjs media:inspect",
    "media:record": "node scripts/run-feature.mjs media:record",
    "dev:core": "pnpm --filter revogrid-demo-core-free dev",
    "dev:core:react": "pnpm --filter revogrid-demo-core-free dev:react",
    "dev:core:vue": "pnpm --filter revogrid-demo-core-free dev:vue",
    "dev:core:angular": "pnpm --filter revogrid-demo-core-free dev:angular",
    "dev:excel": "pnpm --filter revogrid-demo-pro-excel dev",
    "dev:excel:react": "pnpm --filter revogrid-demo-pro-excel dev:react",
    "dev:excel:vue": "pnpm --filter revogrid-demo-pro-excel dev:vue",
    "dev:excel:angular": "pnpm --filter revogrid-demo-pro-excel dev:angular",
    "dev:pivot": "pnpm --dir features/pivot dev",
    "dev:pivot:react": "pnpm --dir features/pivot dev:react",
    "dev:pivot:vue": "pnpm --dir features/pivot dev:vue",
    "dev:pivot:angular": "pnpm --dir features/pivot dev:angular",
    "dev:kanban": "pnpm --dir features/kanban dev",
    "dev:kanban:react": "pnpm --dir features/kanban dev:react",
    "dev:kanban:vue": "pnpm --dir features/kanban dev:vue",
    "dev:kanban:angular": "pnpm --dir features/kanban dev:angular",
    "dev:scheduler": "pnpm --dir features/scheduler dev",
    "dev:scheduler:react": "pnpm --dir features/scheduler dev:react",
    "dev:scheduler:vue": "pnpm --dir features/scheduler dev:vue",
    "dev:scheduler:angular": "pnpm --dir features/scheduler dev:angular",
    "dev:gantt": "pnpm --dir features/gantt dev",
    "dev:gantt:react": "pnpm --dir features/gantt dev:react",
    "dev:gantt:vue": "pnpm --dir features/gantt dev:vue",
    "dev:gantt:angular": "pnpm --dir features/gantt dev:angular",
    "dev:planning": "pnpm --filter revogrid-demo-pro-advanced-planning dev",
    "dev:planning:react": "pnpm --filter revogrid-demo-pro-advanced-planning dev:react",
    "dev:planning:vue": "pnpm --filter revogrid-demo-pro-advanced-planning dev:vue",
    "dev:planning:angular": "pnpm --filter revogrid-demo-pro-advanced-planning dev:angular",
    "dev:ecommerce": "pnpm --filter revogrid-demo-pro-e-commerce dev",
    "dev:ecommerce:react": "pnpm --filter revogrid-demo-pro-e-commerce dev:react",
    "dev:ecommerce:vue": "pnpm --filter revogrid-demo-pro-e-commerce dev:vue",
    "dev:ecommerce:angular": "pnpm --filter revogrid-demo-pro-e-commerce dev:angular",
    "dev:project": "pnpm --filter revogrid-demo-pro-project-table dev",
    "dev:project:react": "pnpm --filter revogrid-demo-pro-project-table dev:react",
    "dev:project:vue": "pnpm --filter revogrid-demo-pro-project-table dev:vue",
    "dev:project:angular": "pnpm --filter revogrid-demo-pro-project-table dev:angular"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.3",
    "@playwright/test": "1.59.1",
    "jsdom": "^29.1.1",
    "playwright": "1.59.1"
  }
}
