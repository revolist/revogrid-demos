# Copy to .env.local. Leave both empty to use scripted responses without model calls.
OPENAI_API_KEY=
AI_MODEL=
# Restrict live interpretation to this grid's data, fields and actions (1 by default).
AI_GRID_ONLY=1
PORT=5189
AI_HOST=127.0.0.1
# HTTP receive deadlines in milliseconds; headers timeout must not exceed request timeout.
AI_REQUEST_TIMEOUT_MS=30000
AI_HEADERS_TIMEOUT_MS=10000
AI_MAX_HEADERS_COUNT=50
AI_MAX_CONNECTIONS=100
# Separate interpretation deadline (milliseconds), body bytes and prompt characters.
AI_INTERPRET_TIMEOUT_MS=30000
AI_MAX_BODY_BYTES=65536
AI_MAX_PROMPT_CHARS=4000

# Remote/production protection. Local mode (0) uses built-in loopback demo origins
# and does not enforce quotas. Production requires AI_REMOTE=1.
AI_REMOTE=0
# Comma-separated exact HTTPS app origins, including a port when needed.
# No wildcards, paths or trailing slash. Required when AI_REMOTE=1.
AI_ALLOWED_ORIGINS=https://your-app.example
# Required in remote mode: private token of at least 32 bytes, held by the host proxy.
AI_ACCESS_TOKEN=
# Persistent storage; run one backend process. Daily usage survives restarts.
AI_USAGE_FILE=.data/ai-usage.json
# Enforced in remote mode; all limits must be positive integers (at most 1000000).
AI_REQUESTS_PER_MINUTE=5
AI_REQUESTS_PER_USER_PER_DAY=20
AI_REQUESTS_PER_DAY=200
AI_MAX_CONCURRENT=2
# Live model output limit, also available in local mode.
AI_MAX_OUTPUT_TOKENS=1024
