# Copy to .env.local on the server. Keep this token and the provider key out of browser code.
AI_REMOTE=1
# Exact HTTPS application origins, comma-separated; no wildcards, paths or trailing slash.
AI_ALLOWED_ORIGINS=https://your-app.example
# Required: at least 32 bytes. Only your authenticated server-side proxy receives it.
AI_ACCESS_TOKEN=
OPENAI_API_KEY=
AI_MODEL=
AI_GRID_ONLY=1
PORT=5189
AI_HOST=127.0.0.1
# HTTP receive deadlines in milliseconds; headers timeout <= request timeout.
AI_REQUEST_TIMEOUT_MS=30000
AI_HEADERS_TIMEOUT_MS=10000
AI_MAX_HEADERS_COUNT=50
AI_MAX_CONNECTIONS=100
# Interpretation deadline in milliseconds; body bytes and prompt characters.
AI_INTERPRET_TIMEOUT_MS=30000
AI_MAX_BODY_BYTES=65536
AI_MAX_PROMPT_CHARS=4000
# Put this file on persistent storage. Run one instance of this backend.
AI_USAGE_FILE=.data/ai-usage.json
# Positive integers, at most 1000000. Limits apply to interpretation requests.
AI_REQUESTS_PER_MINUTE=5
AI_REQUESTS_PER_USER_PER_DAY=20
AI_REQUESTS_PER_DAY=200
AI_MAX_CONCURRENT=2
AI_MAX_OUTPUT_TOKENS=1024
