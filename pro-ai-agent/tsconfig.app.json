{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "strict": true,
    "paths": {
      "@revolist/revogrid": [
        "../../../node_modules/@revolist/revogrid"
      ],
      "@revolist/revogrid/*": [
        "../../../node_modules/@revolist/revogrid/*"
      ],
      "@revolist/react-datagrid": [
        "../../../node_modules/@revolist/react-datagrid"
      ],
      "@revolist/vue3-datagrid": [
        "../../../node_modules/@revolist/vue3-datagrid"
      ],
      "@revolist/angular-datagrid": [
        "../../../node_modules/@revolist/angular-datagrid"
      ],
      "@revolist/revogrid-pro": [
        "../../../packages/pro"
      ],
      "@revolist/pivot": [
        "../../../packages/pivot"
      ],
      "@revolist/charts": [
        "../../../packages/charts"
      ],
      "@revolist/ui": [
        "../../../packages/ui"
      ],
      "react": [
        "../../../node_modules/@types/react"
      ],
      "react/*": [
        "../../../node_modules/@types/react/*"
      ],
      "react-dom": [
        "../../../node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "../../../node_modules/@types/react-dom/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/backend"
  ]
}
